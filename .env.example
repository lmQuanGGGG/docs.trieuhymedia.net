# Sao chép thành .env.local rồi điền mật khẩu thật (xem docs/database.md).
# Dev: qua SSH tunnel localhost:5433 -> droplet 127.0.0.1:5432
DATABASE_URL="postgresql://trieuhy_app:CHANGE_ME@localhost:5433/trieuhy_docs?schema=public"
# Chỉ cần cho `prisma migrate dev` (database shadow riêng, user không có quyền CREATEDB)
SHADOW_DATABASE_URL="postgresql://trieuhy_app:CHANGE_ME@localhost:5433/trieuhy_docs_shadow?schema=public"
# Khoá ký phiên đăng nhập: openssl rand -base64 48
AUTH_SECRET="<chuỗi ngẫu nhiên dài>"
# Thư mục lưu tệp tải lên
STORAGE_DIR="./storage"
# Mật khẩu dev cho tài khoản seed (không dùng ở production)
SEED_DEFAULT_PASSWORD="<mật khẩu dev>"
